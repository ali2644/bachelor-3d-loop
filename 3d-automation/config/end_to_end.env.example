# Copy this file to config/end_to_end.env and replace the placeholders.
# Never commit the copied file because it contains the PrusaLink API key.

PRINTER_IP=10.8.170.57
PRUSALINK_API_KEY=REPLACE_WITH_NEW_API_KEY
ROBOT_IP=10.8.170.41
QS_BASE_URL=http://REPLACE_WITH_RASPBERRY_PI_IP:8000
CAMERA_BASE_URL=http://REPLACE_WITH_RASPBERRY_PI_IP:8000

PRUSASLICER_PATH=/home/REPLACE_WITH_USER/apps/prusaslicer/PrusaSlicer-2.9.1-x86_64.AppImage
REMOTE_GCODE_PATH=FOLDER/demo.gcode

PRINT_POLL_SECONDS=15
PRINT_START_TIMEOUT_SECONDS=180
PRINT_TIMEOUT_SECONDS=28800
MAX_STATUS_ERRORS=5
PART_COOLING_SECONDS=0

# These four variables are used on the Raspberry Pi by the QS/camera API.
CAMERA_DEVICE_PATH=/dev/video0
CAMERA_OUTPUT_DIR=data/camera_images
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_PIXEL_FORMAT=mjpeg